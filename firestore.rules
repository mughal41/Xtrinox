rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- HELPER FUNCTIONS ---
    function isAuthenticated() { return request.auth != null; }
    function isAdmin() { 
      return request.auth != null && 
             ('admin' in request.auth.token) && 
             request.auth.token.admin == true; 
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- MARKETPLACE & TOOLS (Public read) ---
    match /marketplace_tools/{toolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- PRODUCT COOKIES (Admin-only sensitive payloads) ---
    match /product_cookies/{cookieId} {
      allow read, write: if isAdmin();
    }

    // --- SUBSCRIPTIONS ---
    match /subscriptions/{subId} {
      allow read: if isAdmin()
                  || isOwner(subId)
                  || isOwner(resource.data.userId);
      allow create, update, delete: if isAdmin();
    }

    // --- ENTITLEMENTS ---
    // Owners may read only their records; only admins may grant/revoke access.
    match /entitlements/{entId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create, update, delete: if isAdmin();
    }

    // --- USER PROFILES ---
    // Safe user updates permitted: displayName, bio, notificationPreferences, hasPendingUnblockRequest, updatedAt
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['displayName', 'bio', 'notificationPreferences', 'hasPendingUnblockRequest', 'updatedAt']));
    }

    // --- WORKSPACE & APPS ---
    // Owners may read only their records; only admins may change assignments.
    match /workspace_apps/{appId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create, update, delete: if isAdmin();
    }

    // --- LAUNCH LOGS ---
    match /launch_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isOwner(request.resource.data.userId);
    }

    // --- ADMIN AUDIT LOGS ---
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create, update, delete: if isAdmin();
    }

    // --- RUNTIME STATES ---
    match /runtime_states/{stateId} {
      allow read, create, update: if isAdmin() || isOwner(stateId);
      allow delete: if isAdmin();
    }

    // --- DEVICES ---
    match /devices/{deviceId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAdmin() || isOwner(request.resource.data.userId);
      allow update: if isAdmin()
                    || (isOwner(resource.data.userId)
                        && isOwner(request.resource.data.userId));
      allow delete: if isAdmin();
    }

    // --- SYSTEM CONFIGS ---
    match /system_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
